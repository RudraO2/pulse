# ── Runtime ───────────────────────────────────────────────────────────
PORT=3210
# Only ONE instance may poll Telegram/Slack at a time (Telegram returns 409 otherwise)
POLLER_ENABLED=true
# Optional: require this token (?token=… once in the dashboard URL) for console/approvals/demo.
# Requests from this laptop are always trusted. If a tunnel is on and this is empty, Pulse generates one.
ADMIN_TOKEN=

# ── Phone app (/m) + "needs you" notifications ────────────────────────
# cloudflared = free HTTPS tunnel so the phone app installs, gets push, and email links work anywhere
TUNNEL=
# Path to cloudflared if it isn't found automatically
CLOUDFLARED_BIN=
# Email DIGEST_TO when something needs the organizer (urgent now, the rest bundled every N minutes)
NOTIFY_EMAIL=true
NOTIFY_BUNDLE_MIN=3
# Notify for scripted demo runs too (the phone buzzes on stage)
NOTIFY_SCRIPTED=true
# Signature on replies an organizer sends from the app
ORGANIZER_NAME=the team

# ── Community profile ─────────────────────────────────────────────────
COMMUNITY_NAME=Build with Swytchcode · Gurgaon
COMMUNITY_ABOUT=A one-day solo buildathon at Thoughtworks Gurgaon where developers build AI agents on Swytchcode APIs.
# Minutes before an unanswered question counts as ignored; how often the care sweep runs
IGNORED_AFTER_MIN=10
SWEEP_EVERY_MIN=5

# ── Swytchcode ────────────────────────────────────────────────────────
# Optional: absolute path to the swytchcode binary (auto-detected from node_modules otherwise)
SWYTCHCODE_BIN=
# Optional: swy_key_ from the Swytchcode dashboard (usage tracking)
SWYTCHCODE_TOKEN=

# ── LLMs (per-step fallback chains, provider:model) ───────────────────
GROQ_API_KEY=
GOOGLE_GENERATIVE_AI_API_KEY=
ANTHROPIC_API_KEY=
# Community replies: fast first, Claude last
LLM_CHAIN=groq:openai/gpt-oss-120b,groq:qwen/qwen3.8-27b,groq:openai/gpt-oss-20b,google:gemini-3.5-flash-lite,anthropic:claude-haiku-4-5-20251001
# Organizer console: Claude first (multi-step reliability)
CONSOLE_CHAIN=anthropic:claude-haiku-4-5-20251001,groq:openai/gpt-oss-120b,google:gemini-3.5-flash-lite
# Digest writing
TRIAGE_CHAIN=groq:openai/gpt-oss-20b,groq:qwen/qwen3.8-27b,google:gemini-3.5-flash-lite

# ── Telegram (community) ──────────────────────────────────────────────
TELEGRAM_BOT_TOKEN=
# numeric id of the community group (negative, e.g. -1001234567890); `npm run spike:telegram` finds it
TELEGRAM_COMMUNITY_CHAT_ID=
# invite link shown as a QR code on the dashboard
TELEGRAM_JOIN_URL=

# ── Slack (community + organizers) ────────────────────────────────────
# Bot scopes: chat:write, chat:write.customize, channels:read, channels:history, groups:read,
# groups:history, im:write, im:history, users:read, reactions:read, reactions:write, pins:write
SLACK_BOT_TOKEN=
# public community channel(s) Pulse answers in
SLACK_GENERAL_CHANNEL_ID=
SLACK_SOCIAL_CHANNEL_ID=
# private organizers channel: questions, escalations, ✅ approvals
SLACK_ESCALATION_CHANNEL_ID=
SLACK_INVITE_URL=

# Swytchcode human approval (Business plan): pins wait for a mod's Approve in Slack.
# Configure the HITL provider first: app.swytchcode.com → Settings → Workspaces → HITL Notifications.
SWYTCHCODE_HITL=false

# ── Notion (knowledge base) ───────────────────────────────────────────
NOTION_TOKEN=
NOTION_DATABASE_ID=

# ── Resend (digests + organizer emails) ───────────────────────────────
RESEND_API_KEY=
DIGEST_TO=
DIGEST_FROM=Pulse <onboarding@resend.dev>
# extra addresses the agent may email (comma-separated); enforced by a Swytchcode policy
EMAIL_ALLOWLIST=
